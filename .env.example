# RAKE - copy to .env and fill in. Commented lines are optional overrides with defaults.

# Enables funding walks (deployer-funded cohort, clusters). Base Mainnet app at dashboard.alchemy.com
ALCHEMY_API_KEY=

# Analyst: set one or both. Claude preferred; Groq is the free fallback. Neither = engine still runs fully.
ANTHROPIC_API_KEY=
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# Telegram watch: bot token from @BotFather; public URL used in alert links.
TELEGRAM_BOT_TOKEN=
RAKE_PUBLIC_URL=http://localhost:3000
# Serverless mode (webhook + Action patrol): Upstash Redis free tier + any random secret string.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Local long-poll mode (pnpm watch) only:
# RAKE_WATCH_INTERVAL_MIN=60

# x402 deep pass (/api/deeppass): your receiving Base wallet. Unset = route runs free and says so.
X402_PAY_TO=
# X402_PRICE=$0.05
# Base Sepolia: the free facilitator settles testnet only. Mainnet (eip155:8453) needs a CDP facilitator.
X402_NETWORK=eip155:84532
# X402_FACILITATOR_URL=https://x402.org/facilitator
