# RAKE — copy to .env and fill in.

# Alchemy (free tier) — enables funding walks: the deployer-funded cohort and
# funding-cluster detection. Create a Base Mainnet app at https://dashboard.alchemy.com
ALCHEMY_API_KEY=

# Analyst — set one (or both) of these. Anthropic (Claude Opus 5) is preferred:
# strongest adherence to the "never produce a number" rule. Groq is the free
# fallback; if both are set, Claude answers and Groq catches auth failures.
# Without either, the deterministic engine still runs fully.
ANTHROPIC_API_KEY=
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# Web server port (default 4173)
# PORT=4173
