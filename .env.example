# RAKE - copy to .env and fill in. Commented lines are optional overrides with defaults.

# Enables funding walks (deployer-funded cohort, clusters). Base Mainnet app at dashboard.alchemy.com
ALCHEMY_API_KEY=

# Analyst: set one or both. Claude preferred; Groq is the free fallback. Neither = engine still runs fully.
ANTHROPIC_API_KEY=
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# Telegram watch (pnpm watch): bot token from @BotFather; public URL used in alert links.
TELEGRAM_BOT_TOKEN=
RAKE_PUBLIC_URL=http://localhost:3000
# RAKE_WATCH_INTERVAL_MIN=60

# x402 deep pass (/api/deeppass): your receiving Base wallet. Unset = route runs free and says so.
X402_PAY_TO=
# X402_PRICE=$0.05
# X402_NETWORK=eip155:8453
# X402_FACILITATOR_URL=https://x402.org/facilitator
